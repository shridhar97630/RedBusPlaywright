{
  "name": "redbus-automation",
  "version": "1.0.0",
  "description": "RedBus browser automation using Playwright, Cucumber BDD and MERV",
  "private": true,
  "main": "index.js",
  "scripts": {
    "pretest": "node scripts/prepare-reports.js",
    "test": "npm run test:bdd",
    "pretest:bdd": "node scripts/prepare-reports.js",
    "test:bdd": "cucumber-js",
    "pretest:smoke": "node scripts/prepare-reports.js",
    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "pretest:regression": "node scripts/prepare-reports.js",
    "test:regression": "cucumber-js --tags \"@regression\"",
    "pretest:search": "node scripts/prepare-reports.js",
    "test:search": "cucumber-js --tags \"@searchBus\"",
    "test:report": "npm run merv:generate",
    "merv:generate": "npm run test:bdd",
    "merv:open": "merv show-report ./merv-report --no-open"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "merv-client-cucumber": "^4.0.25",
    "playwright": "^1.64.1"
  }
}
